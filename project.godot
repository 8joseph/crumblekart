; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="crumblekart"
run/main_scene="res://scenes/ui/menuscene.tscn"
boot_splash/image="res://assets/ui elements/logo/logofinal.png"
boot_splash/bg_color=Color( 1, 1, 1, 1 )
config/icon="res://assets/ui elements/logo/small logo.png"

[autoload]

Network="*res://scripts/network.gd"
Global="*res://scripts/global.gd"

[debug]

settings/fps/force_fps=60
multirun/number_of_windows=2
multirun/window_distance=1270
multirun/add_custom_args=true
multirun/first_window_args="listen"
multirun/other_window_args="join"

[display]

window/size/width=1280
window/size/height=720
window/size/always_on_top=true
window/vsync/use_vsync=false

[editor_plugins]

enabled=PoolStringArray( "res://addons/multirun/plugin.cfg" )

[global]

shadow=false

